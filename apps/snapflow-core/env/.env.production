# ========== ОКРУЖЕНИЕ ==========
# Окружение приложения (development, production, testing и т.п.)
NODE_ENV=

# ========== API ==========
# Порт, на котором запускается приложение
PORT=

## Ключ для подписи Access токена
JWT_SECRET_AT=
## Ключ для подписи Refresh токена
JWT_SECRET_RT=
## Время жизни Access токена
JWT_EXPIRATION_AT=
## Время жизни Refresh токена
JWT_EXPIRATION_RT=

## Идентификатор клиента (client ID) для аутентификации через Google OAuth
GOOGLE_CLIENT_ID=
## Секрет клиента (client secret) для аутентификации через Google OAuth
GOOGLE_CLIENT_SECRET=
## URL, на который Google будет перенаправлять пользователя после успешной аутентификации
GOOGLE_CALLBACK_URL=

## Идентификатор клиента (client ID) для аутентификации через Github OAuth
GITHUB_OAUTH_CLIENT_ID=
## Секрет клиента (client secret) для аутентификации через Github OAuth
GITHUB_OAUTH_CLIENT_SECRET=
## URL, на который Github будет перенаправлять пользователя после успешной аутентификации
GITHUB_OAUTH_CALLBACK_URL=

## URL, на который будет происходить редирект пользователя после подтверждения авторизации при OAuth
BASE_FRONT_URL=

## Секретный ключ Google reCAPTCHA для серверной валидации капчи
GOOGLE_RECAPTCHA_SECRET_KEY=

## Устанавливает флаг HttpOnly для cookie, чтобы ограничить доступ клиентского JavaScript к ним (true/false)
HTTP_ONLY=
## Устанавливает флаг Secure для cookie; если true, cookie передаются только по HTTPS соединению (true/false)
SECURE=
## Политика SameSite для cookie, ограничивающая отправку cookie в кросс-доменных запросах (strict, lax, none)
SAME_SITE=
## Максимальное время жизни cookie в миллисекундах (например, 3600000 для часа)
MAX_AGE=

## Список доменов (через запятую), которым разрешён доступ к API (CORS)
ALLOWED_ORIGINS=

## Время жизни "окна" для лимита запросов (throttling) в секундах, например: 10000
THROTTLE_TTL=
## Максимальное количество запросов, разрешенных за TTL (throttle window), например: 5
THROTTLE_LIMIT=

## должен ли быть открыт Swagger
IS_SWAGGER_ENABLED=

## отправлять клиенту детали ошибки (сообщение, урл...) при INTERNAL_SERVER_ERROR
SEND_INTERNAL_SERVER_ERROR_DETAILS=

## Строка подключения к серверу Redis (redis://user:pass@host:port) для кэширования и хранения временных данных
REDIS_URL=

## Секретный токен для безопасной On-Demand ревалидации кэша между бэкендом и фронтендом
NEXTJS_REVALIDATION_SECRET=
## Время жизни токена для вебхука (в формате ms: '1m', '5m', '60s')
NEXTJS_REVALIDATION_TOKEN_EXPIRES_IN=

## URL подключения к RabbitMQ (AMQP/AMQPS), через который snapflow-core получает события из payments сервиса
RABBITMQ_URL=

## Имя очереди RabbitMQ для входящих событий payments (PAYMENT_COMPLETED, PAYMENT_FAILED), которую слушает snapflow-core
PAYMENTS_EVENTS_QUEUE_NAME=
## Имя очереди RabbitMQ для событий notifications, используемой snapflow-core
NOTIFICATIONS_EVENTS_QUEUE_NAME=
## Имя очереди RabbitMQ для событий messenger notifications, которую слушает snapflow-core
MESSENGER_EVENTS_QUEUE_NAME=

## Публичный VAPID-ключ для Web Push (генерация: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
## Приватный VAPID-ключ для Web Push
VAPID_PRIVATE_KEY=
## Contact URI для VAPID (mailto: или https://)
VAPID_SUBJECT=

## Имя приложения в New Relic
NEW_RELIC_APP_NAME=
## Лицензионный ключ New Relic
NEW_RELIC_LICENSE_KEY=
## Уровень логирования агента New Relic (например: info, debug)
NEW_RELIC_LOG_LEVEL=
## Включение/выключение New Relic агента (true/false)
NEW_RELIC_ENABLED=

## Публичный base URL API
PUBLIC_API_BASE_URL=

# ========== БАЗА ДАННЫХ ==========
## Строка подключения к базе данных PostgreSQL (postgres://user:pass@host:port/dbname)
DATABASE_URL=
## Флаг, включающий или отключающий логирование SQL-запросов Prisma (true/false)
PRISMA_LOG_QUERIES=

# ========== БИЗНЕС ПРАВИЛА ==========
## Основной email с которого будет осуществляться рассылка пользователям
EMAIL_APP=
## Пароль основного email с которого будет осуществляться рассылка пользователям
EMAIL_APP_PASSWORD=

## Количество дней хранения мягко удаленных (soft-deleted) сессий перед их окончательным (hard) удалением.
SESSION_CLEANUP_RETENTION_DAYS=
## Количество дней хранения обработанных outbox-событий перед очисткой.
OUTBOX_RETENTION_DAYS=
## Количество дней хранения записей об обработанных событиях (дедупликация консьюмеров) перед очисткой.
CONSUMED_EVENTS_RETENTION_DAYS=

# ========== SWAGGER ==========
## Имя пользователя для доступа к Swagger UI через HTTP Basic Auth
SWAGGER_USER=
## Пароль для доступа к Swagger UI через HTTP Basic Auth
SWAGGER_PASSWORD=
## URL-путь, по которому доступна Swagger-документация
SWAGGER_PATH=
## URL, по которому доступна Swagger-документация сервиса Payments
PAYMENTS_SWAGGER_URL=
## URL, по которому доступна Swagger-документация сервиса Messenger
PAYMENTS_SWAGGER_URL=

# ========== EXTERNAL SERVICES SETTINGS ==========
## Хост файлового микросервиса (TCP соединение), например: localhost, 0.0.0.0
FILES_SERVICE_HOST=
## Порт файлового микросервиса (TCP соединение), например: 3001
FILES_SERVICE_PORT=

# ========== LOGGER ==========
## Уровень логирования приложения (trace, debug, info, warn, error, fatal)
LOGGER_LEVEL=

# ========== ADMIN (GraphQL суперадминка) ==========
## Email суперадмина для входа через mutation adminLogin
ADMIN_EMAIL=
## Пароль суперадмина для входа через mutation adminLogin
ADMIN_PASSWORD=
## Время жизни admin-сессии в часах. Например: 24
ADMIN_SESSION_MAX_AGE_HOURS=
## Базовый URL сервиса Payments для внутренних HTTP-запросов
PAYMENTS_SERVICE_URL=
## Секрет для аутентификации внутренних API-запросов между сервисами
INTERNAL_API_SECRET=
