{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "../",
  "testEnvironment": "node",
  "testRegex": ".unit-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^@generated/(.*)$": "<rootDir>/../../generated/$1",
    "^libs/(.*)": "<rootDir>/../../libs/$1"
  }
}
