# ========== ОКРУЖЕНИЕ ==========
# Окружение приложения (development, production, testing и т.п.)
NODE_ENV=

# ========== API ==========
# Порт, на котором запускается приложение
PORT=

## Публичный base URL API
PUBLIC_API_BASE_URL=

## Ключ для подписи Access токена
JWT_SECRET_AT=

## URL основного микросервиса
CORE_SERVICE_URL=

## Список доменов (через запятую), которым разрешён доступ к API (CORS)
ALLOWED_ORIGINS=

## отправлять клиенту детали ошибки (сообщение, урл...) при INTERNAL_SERVER_ERROR
SEND_INTERNAL_SERVER_ERROR_DETAILS=

## Строка подключения к серверу Redis (redis://user:pass@host:port) для кэширования и хранения временных данных
REDIS_URL=

## Строка подключения к RabbitMQ (amqp://user:pass@host:port)
RABBITMQ_URL=

# ========== БАЗА ДАННЫХ ==========
## Строка подключения к базе данных PostgreSQL (postgres://user:pass@host:port/dbname)
DATABASE_URL=
## Флаг, включающий или отключающий логирование SQL-запросов Prisma (true/false)
PRISMA_LOG_QUERIES=

# ========== SWAGGER ==========
## Имя пользователя для доступа к Swagger UI через HTTP Basic Auth
SWAGGER_USER=
## Пароль для доступа к Swagger UI через HTTP Basic Auth
SWAGGER_PASSWORD=
## URL-путь, по которому доступна Swagger-документация
SWAGGER_PATH=

# ========== LOGGER ==========
## Уровень логирования приложения (trace, debug, info, warn, error, fatal)
LOGGER_LEVEL=

# ========== БИЗНЕС-ПРАВИЛА (ОПЦИОНАЛЬНО) ==========
# Переменные ниже необязательны: если не заданы или заданы некорректно,
# используются значения по умолчанию из кода (см. business-rules-settings.ts).

## Окно редактирования сообщения в миллисекундах с момента createdAt (только автор)
## По умолчанию: 900000 (15 минут)
MESSAGE_EDIT_WINDOW_MS=

## Окно удаления сообщения «для всех» в миллисекундах с момента createdAt (только автор)
## По умолчанию: 900000 (15 минут)
MESSAGE_DELETE_FOR_EVERYONE_WINDOW_MS=

## TTL индикатора «печатает…» в Redis в секундах (сервер обновляет ключ при typing.start)
## По умолчанию: 3
TYPING_TTL_SECONDS=

## TTL присутствия (presence) в Redis в секундах; клиент обновляет через presence.heartbeat
## По умолчанию: 30 (минимум: 5)
PRESENCE_HEARTBEAT_TTL_SECONDS=

## Grace-период (сек) перед публикацией пуш-события из outbox; 0 = без задержки
## По умолчанию: 20
PUSH_NOTIFICATION_DELAY_SECONDS=

## Максимальная длина preview текста в пуш-уведомлении
## По умолчанию: 120
PUSH_PREVIEW_MAX_LENGTH=

## Сколько дней хранить PROCESSED-события в outbox перед cleanup
## По умолчанию: 30
OUTBOX_RETENTION_DAYS=
