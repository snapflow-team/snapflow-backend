# ========== ОКРУЖЕНИЕ ==========
NODE_ENV=development

# ========== API ==========
PORT=5010

CORE_SERVICE_URL=http://localhost:3000

PUBLIC_API_BASE_URL=http://0.0.0.0

ALLOWED_ORIGINS=http://localhost:3000

SEND_INTERNAL_SERVER_ERROR_DETAILS=true

REDIS_URL=redis://localhost:6379

RABBITMQ_URL=amqp://guest:guest@localhost:5672

# ========== БАЗА ДАННЫХ ==========
DATABASE_URL=postgresql://username:password123@localhost:5432/db_name?connection_timeout=10000
PRISMA_LOG_QUERIES=true

# ========== SWAGGER ==========
SWAGGER_USER=swagger
SWAGGER_PASSWORD=qwerty
SWAGGER_PATH=docs

# ========== БИЗНЕС ПРАВИЛА ==========


# ========== LOGGER ==========
LOGGER_LEVEL=trace
