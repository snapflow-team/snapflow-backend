generator client {
  provider = "prisma-client-js"
  output   = "../../../generated/prisma-messenger"
}

datasource db {
  provider = "postgresql"
}

enum OutboxEventStatus {
  PENDING
  PROCESSING
  PROCESSED
  SKIPPED
  FAILED
}

enum OutboxEventType {
  NEW_MESSAGE_NOTIFICATION
}

model Chat {
  id             Int                @id @default(autoincrement())
  participantAId Int                @map("participant_a_id")
  participantBId Int                @map("participant_b_id")
  lastMessageId  Int?               @unique @map("last_message_id")
  lastMessageAt  DateTime?          @map("last_message_at")
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")
  messages       Message[]
  lastMessage    Message?           @relation("ChatLastMessage", fields: [lastMessageId], references: [id], onDelete: SetNull)
  readStates     ChatReadState[]
  muteSettings   ChatMuteSettings[]

  @@unique([participantAId, participantBId])
  @@index([participantAId, lastMessageAt])
  @@index([participantBId, lastMessageAt])
  @@map("chats")
}

model Message {
  id                 Int                   @id @default(autoincrement())
  chatId             Int                   @map("chat_id")
  senderId           Int                   @map("sender_id")
  text               String                @db.VarChar(1000)
  clientMessageId    String                @map("client_message_id") @db.Uuid
  createdAt          DateTime              @default(now()) @map("created_at")
  editedAt           DateTime?             @map("edited_at")
  deletedAt          DateTime?             @map("deleted_at")
  deletedForEveryone Boolean               @default(false) @map("deleted_for_everyone")
  replyToMessageId   Int?                  @map("reply_to_message_id")
  chat               Chat                  @relation(fields: [chatId], references: [id], onDelete: Cascade)
  lastMessageOfChat  Chat?                 @relation("ChatLastMessage")
  readStates         ChatReadState[]
  replyTo            Message?              @relation("MessageReply", fields: [replyToMessageId], references: [id], onDelete: SetNull)
  replies            Message[]             @relation("MessageReply")
  deliveries         MessageDelivery[]
  userDeletions      MessageUserDeletion[]

  @@unique([chatId, senderId, clientMessageId])
  @@index([chatId, createdAt])
  @@map("messages")
}

model ChatReadState {
  id                Int       @id @default(autoincrement())
  chatId            Int       @map("chat_id")
  userId            Int       @map("user_id")
  lastReadMessageId Int?      @map("last_read_message_id")
  lastReadAt        DateTime? @map("last_read_at")
  chat              Chat      @relation(fields: [chatId], references: [id], onDelete: Cascade)
  lastReadMessage   Message?  @relation(fields: [lastReadMessageId], references: [id], onDelete: SetNull)

  @@unique([chatId, userId])
  @@map("chat_read_states")
}

model MessageDelivery {
  id          Int      @id @default(autoincrement())
  messageId   Int      @map("message_id")
  userId      Int      @map("user_id")
  deliveredAt DateTime @default(now()) @map("delivered_at")
  message     Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@map("message_deliveries")
}

model MessageUserDeletion {
  id        Int      @id @default(autoincrement())
  messageId Int      @map("message_id")
  userId    Int      @map("user_id")
  deletedAt DateTime @default(now()) @map("deleted_at")
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@map("message_user_deletions")
}

model UserPresenceSettings {
  userId             Int       @id @map("user_id")
  showActivityStatus Boolean   @default(true) @map("show_activity_status")
  lastSeenAt         DateTime? @map("last_seen_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  @@map("user_presence_settings")
}

model OutboxEvent {
  id          String            @id @default(uuid()) @db.Uuid
  type        OutboxEventType
  payload     Json              @db.JsonB
  status      OutboxEventStatus @default(PENDING)
  availableAt DateTime          @map("available_at")
  error       String?           @db.Text
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  @@index([status, availableAt])
  @@map("outbox_events")
}

model ChatMuteSettings {
  chatId     Int       @map("chat_id")
  userId     Int       @map("user_id")
  mutedUntil DateTime? @map("muted_until")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@id([chatId, userId])
  @@map("chat_mute_settings")
}
