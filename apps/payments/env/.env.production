# ========== ОКРУЖЕНИЕ ==========
# Окружение приложения (development, production, testing и т.п.)
NODE_ENV=

# ========== API ==========
# Порт, на котором запускается приложение
PORT=

## URL основного микросервиса
CORE_SERVICE_URL=

## Список доменов (через запятую), которым разрешён доступ к API (CORS)
ALLOWED_ORIGINS=

## отправлять клиенту детали ошибки (сообщение, урл...) при INTERNAL_SERVER_ERROR
SEND_INTERNAL_SERVER_ERROR_DETAILS=

## Строка подключения к серверу Redis (redis://user:pass@host:port) для кэширования и хранения временных данных
REDIS_URL=

## Строка подключения к серверу RebbitMQ (amqps://user:pass@host) для хранения очередей
RABBITMQ_URL=

## Секретный API-ключ Stripe для серверных запросов (начинается с sk_test_ или sk_live_)
STRIPE_SECRET_KEY=
## Секретный ключ для проверки подписей вебхуков (Webhook Secret) от Stripe (начинается с whsec_)
STRIPE_WEBHOOK_SECRET=
## URL, на который пользователь будет перенаправлен после успешной оплаты в Stripe Checkout
STRIPE_SUCCESS_URL=
## URL, на который пользователь будет перенаправлен, если отменит оплату или закроет страницу Stripe Checkout
STRIPE_CANCEL_URL=

# ========== БАЗА ДАННЫХ ==========
## Строка подключения к базе данных PostgreSQL (postgres://user:pass@host:port/dbname)
DATABASE_URL=
## Флаг, включающий или отключающий логирование SQL-запросов Prisma (true/false)
PRISMA_LOG_QUERIES=


# ========== БИЗНЕС ПРАВИЛА ==========
## Идентификатор цены (Price ID) в Stripe для тарифа "Business" (Ежемесячная оплата)
STRIPE_PRICE_ID_BUSINESS_MONTHLY=
## Идентификатор цены (Price ID) в Stripe для тарифа "Business" (Ежегодная оплата)
STRIPE_PRICE_ID_BUSINESS_YEARLY=

# ========== SWAGGER ==========
## Имя пользователя для доступа к Swagger UI через HTTP Basic Auth
SWAGGER_USER=
## Пароль для доступа к Swagger UI через HTTP Basic Auth
SWAGGER_PASSWORD=
## URL-путь, по которому доступна Swagger-документация
SWAGGER_PATH=

# ========== LOGGER ==========
## Уровень логирования приложения (trace, debug, info, warn, error, fatal)
LOGGER_LEVEL=