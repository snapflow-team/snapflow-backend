generator client {
  provider = "prisma-client-js"
  output   = "../../../generated/prisma-payments"
}

datasource db {
  provider = "postgresql"
}

enum AccountType {
  PERSONAL
  BUSINESS
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  PAST_DUE //Этот статус значит, что подписка уже истекла, но страйп будет делать попытки ее оплатить
  PENDING
}

enum PaymentProvider {
  STRIPE
  PAYPAL
}

enum PaymentStatus {
  PAID
  FAILED
  PENDING
}

enum OutboxEventType {
  SUBSCRIPTION_ACTIVATED
  CHECKOUT_SESSION_EXPIRED
  SUBSCRIPTION_RENEWAL_FAILED
  SUBSCRIPTION_CANCELLED
  SUBSCRIPTION_RENEWED
}

enum OutboxEventStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
}

model Subscription {
  id                 Int                @id @default(autoincrement())
  planId             String             @map("plan_id")
  stripeSubId        String?            @map("stripe_sub_id")
  accountType        AccountType        @default(PERSONAL) @map("account_type")
  status             SubscriptionStatus @default(PENDING)
  autoRenewal        Boolean            @default(true) @map("auto_renewal")
  currentPeriodStart DateTime?          @map("current_period_start")
  currentPeriodEnd   DateTime?          @map("current_period_end")
  nextPaymentAt      DateTime?          @map("next_payment_at")
  lastStripeEventAt  DateTime?          @map("last_stripe_event_at")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  payments Payment[]

  customer   Customer @relation(fields: [customerId], references: [id])
  customerId Int      @map("customer_id")

  @@map("subscriptions")
}

model Payment {
  id         Int             @id @default(autoincrement())
  planId     String          @map("plan_id")
  /// ВНИМАНИЕ: Поле externalId имеет уникальное ограничение в БД только для активных записей (Soft Delete).
  /// @unique убран из схемы намеренно, чтобы можно было создавать новую подписку после удаления старой.
  /// Добавлено в миграции: 20260326091256_init_payments_schema
  externalId String?         @map("external_id")
  provider   PaymentProvider @default(STRIPE)
  amount     Int
  //todo(vitaliy) убрать дефолт и сделать enum из доступных currency
  currency   String          @default("usd")
  status     PaymentStatus

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  subscription   Subscription @relation(fields: [subscriptionId], references: [id])
  subscriptionId Int          @map("subscription_id")

  @@map("payments")
}

model OutboxEvent {
  id      String            @id @default(uuid()) @db.Uuid
  type    OutboxEventType
  payload Json              @db.JsonB
  status  OutboxEventStatus @default(PENDING)
  error   String?           @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status, createdAt])
  @@map("outbox_events")
}

model Customer {
  id          Int     @id @default(autoincrement())
  stripeCusId String? @map("stripe_cus_id")
  userId      Int     @map("user_id")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  subscription Subscription[]

  @@index([userId])
  @@map("customers")
}
