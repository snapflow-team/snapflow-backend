# ========== ОКРУЖЕНИЕ ==========
NODE_ENV=testing

# ========== MICROSERVICE ==========
FILES_TCP_HOST=0.0.0.0
FILES_TCP_PORT=3005

SEND_INTERNAL_SERVER_ERROR_DETAILS=true

OUTBOX_RETENTION_DAYS=30

# ========== БАЗА ДАННЫХ ==========
DATABASE_URL=postgresql://username:password123@localhost:5432/db_name?connection_timeout=10000
PRISMA_LOG_QUERIES=true

# ========== S3 ==========
S3_REGION=eu-central-1
S3_BUCKET=snapflow-backet
S3_ACCESS_KEY=AKIAIOSFODNN7EXAMPLE
S3_ENDPOINT=https://s3.eu-central-1.amazonaws.com
S3_SECRET_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
S3_PUBLIC_BASE_URL=https://cdn.snapflow.com
S3_PRESIGNED_EXPIRES_IN=600
S3_POSTS_MEDIA_KEY_PREFIX=snapflow/media/posts
S3_AVATARS_MEDIA_KEY_PREFIX=snapflow/media/avatars

# ========== LOGGER ==========
LOGGER_LEVEL=trace

# ========== STORAGE INGEST (HTTP) ==========
STORAGE_INGEST_PORT=3006
STORAGE_INGEST_PUBLIC_HOST=http://localhost:3006
STORAGE_INGEST_ALLOWED_ORIGINS=*
JWT_SECRET_AT=access-secret

# ========== STORAGE PLATFORM ==========
S3_PRIVATE_BUCKET=snapflow-private-bucket
S3_PRIVATE_SSE_MODE=AES256
STORAGE_SIGNED_URL_TTL_SECONDS=300
STORAGE_UPLOAD_SESSION_TTL_SECONDS=86400
STORAGE_CHUNK_SIZE_BYTES=5242880
STORAGE_ORPHAN_TTL_SECONDS=604800
STORAGE_QUOTA_BYTES_PER_MINUTE=1073741824
STORAGE_MAX_CONCURRENT_UPLOADS=5

# ========== STORAGE QUEUE ==========
REDIS_URL=redis://localhost:6379
STORAGE_QUEUE_PREFIX=storage
STORAGE_IMAGE_WORKER_CONCURRENCY=2
STORAGE_DOCUMENT_WORKER_CONCURRENCY=4
STORAGE_FFMPEG_WORKER_CONCURRENCY=1
STORAGE_OUTBOX_POLL_INTERVAL_MS=1000
STORAGE_OUTBOX_BATCH_SIZE=50

# ========== CLAMAV ==========
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=30000
CLAMAV_DEGRADATION_MODE=noop

# ========== MEDIA PROCESSING ==========
FFMPEG_PATH=/usr/bin/ffmpeg
FFPROBE_PATH=/usr/bin/ffprobe
STORAGE_WORKER_TEMP_DIR=/tmp/storage-worker
FFMPEG_MAX_DURATION_SECONDS=600
FFMPEG_MAX_INPUT_BYTES=104857600