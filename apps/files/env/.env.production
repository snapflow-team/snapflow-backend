# ========== ОКРУЖЕНИЕ ==========
## Окружение приложения (development, production, testing и т.п.)
NODE_ENV=

# ========== MICROSERVICE ==========
## Хост файлового микросервиса (TCP соединение), например: localhost, 0.0.0.0
FILES_TCP_HOST=
## Порт файлового микросервиса (TCP соединение), например: 3002
FILES_TCP_PORT=

## Отправлять клиенту детали ошибки (сообщение, URL, стек) при INTERNAL_SERVER_ERROR (true/false)
SEND_INTERNAL_SERVER_ERROR_DETAILS=

# Количество дней хранения обработанных событий в Outbox
OUTBOX_RETENTION_DAYS=

# ========== БАЗА ДАННЫХ ==========
## Строка подключения к базе данных PostgreSQL (postgres://user:pass@host:port/dbname?schema=public)
DATABASE_URL=
## Флаг, включающий или отключающий логирование SQL-запросов Prisma (true/false)
PRISMA_LOG_QUERIES=

# ========== S3 ==========
## Регион AWS S3 (например: eu-central-1, us-east-1)
S3_REGION=
## URL endpoint'а S3 (AWS или S3-совместимый сервис), например: https://s3.amazonaws.com
S3_ENDPOINT=
## Имя S3 bucket'а для хранения файлов
S3_BUCKET=
## AWS Access Key ID для доступа к S3
S3_ACCESS_KEY=
## AWS Secret Access Key для доступа к S3
S3_SECRET_KEY=
## Публичный базовый URL для доступа к файлам (CDN), например: https://cdn.snapflow.com
S3_PUBLIC_BASE_URL=
## Время жизни presigned URL для загрузки в секундах (по умолчанию 15 минут)
S3_PRESIGNED_EXPIRES_IN=
## Префикс ключей для медиафайлов постов в S3 (папка)
S3_POSTS_MEDIA_KEY_PREFIX=
## Префикс ключей для медиафайлов аватаров в S3 (папка)
S3_AVATARS_MEDIA_KEY_PREFIX=

# ========== LOGGER ==========
## Уровень логирования приложения (trace, debug, info, warn, error, fatal)
LOGGER_LEVEL=

# ========== STORAGE INGEST (HTTP) ==========
## Порт HTTP ingest entrypoint для загрузки файлов
STORAGE_INGEST_PORT=
## Публичный базовый URL ingest API, например: https://storage-ingest.snapflow.com
STORAGE_INGEST_PUBLIC_HOST=
## Разрешённые CORS origins через запятую или * для всех
STORAGE_INGEST_ALLOWED_ORIGINS=
## Секрет для проверки JWT access token (тот же, что в snapflow-core/messenger)
JWT_SECRET_AT=

# ========== STORAGE PLATFORM ==========
## Приватный S3 bucket для storage platform (отдельно от legacy public bucket)
S3_PRIVATE_BUCKET=
## Режим server-side encryption для приватного bucket (например: AES256)
S3_PRIVATE_SSE_MODE=
## TTL presigned GET URL в секундах
STORAGE_SIGNED_URL_TTL_SECONDS=
## TTL незавершённой upload session в секундах
STORAGE_UPLOAD_SESSION_TTL_SECONDS=
## Размер upload chunk в байтах (кроме последнего чанка)
STORAGE_CHUNK_SIZE_BYTES=
## TTL orphan READY объектов без attach в секундах
STORAGE_ORPHAN_TTL_SECONDS=
## Квота upload bytes на owner/profile в минуту
STORAGE_QUOTA_BYTES_PER_MINUTE=
## Максимум параллельных upload sessions на owner/profile
STORAGE_MAX_CONCURRENT_UPLOADS=

# ========== STORAGE QUEUE ==========
## URL Redis для BullMQ storage worker
REDIS_URL=
## Префикс имён storage очередей
STORAGE_QUEUE_PREFIX=
## Concurrency image processing worker
STORAGE_IMAGE_WORKER_CONCURRENCY=
## Concurrency document processing worker
STORAGE_DOCUMENT_WORKER_CONCURRENCY=
## Concurrency ffmpeg processing worker
STORAGE_FFMPEG_WORKER_CONCURRENCY=
## Интервал polling storage outbox relay в миллисекундах
STORAGE_OUTBOX_POLL_INTERVAL_MS=
## Размер batch при чтении storage outbox
STORAGE_OUTBOX_BATCH_SIZE=

# ========== CLAMAV ==========
## Хост ClamAV daemon
CLAMAV_HOST=
## Порт ClamAV daemon
CLAMAV_PORT=
## Таймаут AV scan в миллисекундах
CLAMAV_TIMEOUT_MS=
## Режим деградации AV: strict (production) или noop (только dev/test)
CLAMAV_DEGRADATION_MODE=

# ========== MEDIA PROCESSING ==========
## Путь к ffmpeg бинарнику
FFMPEG_PATH=
## Путь к ffprobe бинарнику
FFPROBE_PATH=
## Временная директория worker для ffmpeg input/output
STORAGE_WORKER_TEMP_DIR=
## Максимальная длительность медиа в секундах
FFMPEG_MAX_DURATION_SECONDS=
## Максимальный размер входного файла для ffmpeg в байтах
FFMPEG_MAX_INPUT_BYTES=
