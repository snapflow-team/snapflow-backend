{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "declaration": false,
    "outDir": "./dist",
    "baseUrl": ".",
    "paths": {
      "@generated/prisma": [
        "./generated/prisma"
      ],
      "@generated/*": [
        "./generated/*"
      ],
      "@libs/*": [
        "../../libs/*/src"
      ]
    }
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "test",
    "**/*spec.ts"
  ]
}

