{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@generated/prisma": [
        "./generated/prisma"
      ],
      "@generated/prisma/*": [
        "./generated/prisma/*"
      ]
    },
    "moduleResolution": "node",
    "declaration": false,
    "outDir": "../../dist/apps/files"
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "test",
    "**/*spec.ts"
  ]
}
