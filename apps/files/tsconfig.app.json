{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@generated/prisma": [
        "./generated/prisma"
      ],
      "@generated/prisma/*": [
        "./generated/prisma/*"
      ],
      "@generated/files/prisma": [
        "./generated/prisma"
      ],
      "@generated/files/prisma/*": [
        "./generated/prisma/*"
      ]
    },
    "moduleResolution": "bundler"
  },
  "outDir": "../../dist/apps/files",
  "declaration": false,
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "test",
    "**/*spec.ts"
  ]
}
