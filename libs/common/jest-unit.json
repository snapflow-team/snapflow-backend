{
  "moduleFileExtensions": [
    "js",
    "json",
    "ts"
  ],
  "rootDir": "../..",
  "roots": [
    "<rootDir>/libs"
  ],
  "testEnvironment": "node",
  "testRegex": "\\.unit-spec\\.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "modulePaths": [
    "<rootDir>/libs",
    "<rootDir>/apps"
  ]
}
